#Question : Average the salary, group by manager_id with rollup - (i.e : Sum of all Average salary).

# Solution
select avg(salary),manager_id from employees
group by manager_id with rollup;


#Notes:

#Note : rollup is an Part of group by
#Note : It is implemented by using the keyword : "with"
#Note : Functionality -> Summing all the values (or) Grand Total

