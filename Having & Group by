#Question - Average the amount based on the Date and Patient Name Should not be "code io".
#HINT : avg amount - group by date -Patient should not be code io

#Solution

select avg(amount) as Average_amount,bill_date
from bills
where P_Name not in('code io')
group by bill_date;




