# 11. Write the query to get Department wise total(sum) salary, display it in descending order according to salary.


use company;
select * from Employee;
select * from Departments;

select d.DepartmentName, sum(e.Salary) as Max_Salary from employee e
join departments d on e.DepartmentID = d.DepartmentID
group by e.DepartmentID
order by Max_Salary desc;

