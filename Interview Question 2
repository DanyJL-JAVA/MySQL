# 13. Write down the query to fetch project name assign to more than one employee,

use company;
select * from ProjectDetail;
select * from employee;

select * from ProjectDetail
where ProjectId in
(select Project_Id from employee 
group by Project_Id
having count(Project_Id) > 1);

