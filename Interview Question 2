#16. Delete (or) Remove - All Duplicates from a table 

#DB : profile
#Table : employees

use profile;
select * from employees;

# ROW_NUMBER - is an WindowFunction

#view
with temptbl as (select EmployeeID,Name,Department,HireDate,
ROW_NUMBER() over(partition by EmployeeID order by HireDate asc) as RoWNum
from employees)
-- Drag an Run both the Query at a time
select EmployeeID,Name,Department,HireDate from temptbl where RoWNum = 1;

 -- Delete
 
delete from employees where HireDate in 
(select HireDate from (
select HireDate, row_number() over(partition by EmployeeID order by HireDate asc) as rownum from employees) t where rownum > 1);


