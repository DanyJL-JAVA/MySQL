# 15. Get employee name, project name order by name from "employee" 
# and "projectdetail" for all employee if project is not assigned then display "NoProjectAssigned".

use company;
select * from employee;
select * from projectdetail;

# Note : 
# 1. use "LEFT JOIN" for fetching the only from the left table | allows NULL values.
# 2. Purpose of "coalesce" -> is use to set a default value if value is NULL

select e.FirstName, coalesce(p.ProjectName,'NoProjectAssigned')
from employee e 
left join projectdetail p
on e.Project_Id = p.ProjectId;

