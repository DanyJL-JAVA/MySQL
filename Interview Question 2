# 12. Get Department wise Maxium salary from "EmployeeDetail" table order by salary ascending.


use company;
select * from employee;
select * from departments;


select d.DepartmentName, max(e.Salary) as Max_Salary from employee e
join departments d on e.DepartmentID = d.DepartmentID
group by e.DepartmentID
order by max(e.Salary) asc;

