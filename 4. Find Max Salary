# second highest salary
# Db : company
# Table : employee


#1
select  max(salary) from employee
where salary < (select max(salary) from employee);

#2
select salary from employee
order by salary desc limit 1 offset 1;

#3 - use of Window Function (row_number())

with tmptbl as (select EmployeeID,FirstName,LastName,DepartmentID,Salary,
row_number() over(order by salary desc) as row_num
from employee)

select  EmployeeID,FirstName,LastName,DepartmentID,Salary from employee
where EmployeeID in (select EmployeeID from tmptbl where row_num = 2);
